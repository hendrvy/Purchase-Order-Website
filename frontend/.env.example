# Copy this file to frontend/.env for local development.

# Base URL of the Go backend (see backend/cmd/main.go, default port 3455).
VITE_API_BASE_URL=http://localhost:3455

# Set to "true" to develop against the in-memory mock data in src/mocks/
# instead of a real backend. Defaults to false (real API).
VITE_USE_MOCKS=false
