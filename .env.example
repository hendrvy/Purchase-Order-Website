# Copy this file to .env at the project root when running `docker-compose up`.
# docker-compose.yml passes these to the postgres and api services.

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=purchase_order_db

# --- Go API container (backend/handlers.go DBConnect) ---
# DB_HOST must be the postgres service name from docker-compose, not localhost.
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=purchase_order_db
DB_PORT=5432
DB_SSLMODE=disable

SECRET_KEY=change-this-to-a-long-random-string

UPLOAD_FOLDER_PATH=/app/uploads
