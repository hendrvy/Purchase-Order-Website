# Copy this file to backend/.env when running the backend locally with
# `go run cmd/main.go` (godotenv loads .env from the current working
# directory). When running via docker-compose, the root-level .env.example
# is used instead (see ../.env.example).

# --- Database ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=purchase_order_db
DB_PORT=5432
DB_SSLMODE=disable

# --- Auth ---
# Any long random string. Used to sign JWT tokens (auth.go LoadSecretKey).
SECRET_KEY=change-this-to-a-long-random-string

# --- File uploads ---
# Directory where uploaded attachments are stored on disk.
UPLOAD_FOLDER_PATH=./uploads

# --- Email (SMTP) for forgot-password reset links ---
# Using Gmail: enable 2-Step Verification on the Google account, then
# create an "App Password" (https://myaccount.google.com/apppasswords) -
# use that 16-character app password here, NOT the regular account
# password. SMTP_FROM is optional; falls back to SMTP_USER if left blank.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# --- Frontend ---
# Base URL of the frontend app, used to build the reset-password link
# embedded in the forgot-password email (e.g. FRONTEND_URL/reset-password?token=...).
FRONTEND_URL=http://localhost:5173
